{
  "name": "rivian-mcp",
  "version": "1.0.0",
  "description": "Read-only Rivian MCP server for vehicle state, software updates and charging",
  "type": "module",
  "bin": {
    "rivian-mcp": "dist/mcp-server.js",
    "rivian": "dist/cli.js"
  },
  "main": "dist/mcp-server.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "start": "node src/mcp-server.ts",
    "build": "node scripts/build.ts",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker && tsc --noEmit -p worker/ui",
    "lint": "biome check .",
    "tdqs:worker-tools": "node scripts/dump-worker-tools.ts",
    "format": "biome check --write .",
    "test": "node --test 'test/*.test.ts' 'worker/test/*.test.ts'",
    "deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote",
    "worker:build": "node worker/scripts/build-ui.ts",
    "worker:dev": "wrangler dev",
    "worker:types": "wrangler types worker/worker-configuration.d.ts"
  },
  "keywords": [
    "rivian",
    "mcp",
    "ev",
    "vehicle",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zentered-studios/rivian-mcp.git"
  },
  "homepage": "https://github.com/zentered-studios/rivian-mcp#readme",
  "bugs": {
    "url": "https://github.com/zentered-studios/rivian-mcp/issues"
  },
  "author": "Patrick Heneise",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "latest",
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "chalk": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/tz-lookup": "^6.1.2",
    "esbuild": "^0.28.2",
    "leaflet": "^1.9.4",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "tz-lookup": "^6.1.25",
    "wrangler": "^4.150.0"
  }
}
